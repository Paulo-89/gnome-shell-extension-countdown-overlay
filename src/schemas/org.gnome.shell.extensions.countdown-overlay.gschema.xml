<?xml version="1.0" encoding="UTF-8"?>
<!-- GSettings schema: every key here is a user-configurable option.
     Compile with: glib-compile-schemas schemas/ -->
<schemalist>
  <schema id="org.gnome.shell.extensions.countdown-overlay" path="/org/gnome/shell/extensions/countdown-overlay/">
    <key name="title" type="s">
      <default>"Countdown"</default>
      <summary>Displayed title</summary>
    </key>
    <key name="target-date" type="s">
      <default>"2030-01-01 00:00"</default>
      <summary>Target date, format YYYY-MM-DD HH:MM</summary>
    </key>
    <key name="finished-text" type="s">
      <default>"Deadline reached"</default>
      <summary>Text shown once the target date has passed</summary>
    </key>
    <key name="title-font-size" type="i">
      <range min="8" max="200"/>
      <default>26</default>
      <summary>Title font size (px)</summary>
    </key>
    <key name="countdown-font-size" type="i">
      <range min="12" max="300"/>
      <default>24</default>
      <summary>Countdown font size (px)</summary>
    </key>
    <key name="title-color" type="s">
      <default>"#FD9EBE"</default>
      <summary>Title color (hexadecimal)</summary>
    </key>
    <key name="countdown-color" type="s">
      <default>"#73AEC5"</default>
      <summary>Countdown color (hexadecimal)</summary>
    </key>
    <key name="position-x" type="i">
      <range min="0" max="10000"/>
      <default>30</default>
      <summary>X position, from the left edge of the primary monitor</summary>
    </key>
    <key name="position-y" type="i">
      <range min="0" max="10000"/>
      <default>60</default>
      <summary>Y position, from the top edge of the primary monitor</summary>
    </key>
    <key name="background-enabled" type="b">
      <default>false</default>
      <summary>Show background behind the overlay</summary>
    </key>
    <key name="background-color" type="s">
      <default>"#000000"</default>
      <summary>Background color (hexadecimal)</summary>
    </key>
    <key name="background-opacity" type="i">
      <range min="0" max="100"/>
      <default>50</default>
      <summary>Background opacity (%)</summary>
    </key>
    <key name="background-padding" type="i">
      <range min="0" max="50"/>
      <default>14</default>
      <summary>Background padding (px)</summary>
    </key>
    <key name="background-corner-radius" type="i">
      <range min="0" max="32"/>
      <default>18</default>
      <summary>Background corner radius (px)</summary>
    </key>
  </schema>
</schemalist>
